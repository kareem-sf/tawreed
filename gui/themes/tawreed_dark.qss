/* Tawreed semantic Qt Widgets theme. Color values are injected by styles.py. */

QWidget {
    color: @color-text;
    background: transparent;
    font-family: "Segoe UI Variable Text", "Segoe UI";
    font-size: 10.25pt;
}

QMainWindow, QWidget#appRoot, QWidget#pageHost, QWidget#pageCanvas, QStackedWidget#pageStack,
QStackedWidget#workbenchStack, QScrollArea#pageScroll, QScrollArea#pageScroll > QWidget > QWidget {
    background: @color-bg;
}
QScrollArea#pageScroll { border: none; }
QScrollArea#pageScroll QWidget#qt_scrollarea_viewport { background: @color-bg; }

QWidget#navRail { background: @color-bg-rail; }
QFrame#railDivider {
    color: @color-border;
    background: @color-border;
    border: none;
    min-width: 1px;
    max-width: 1px;
}
QLabel#railLogo { min-width: 42px; min-height: 42px; }
QLabel#railBrandName { font-size: 16pt; font-weight: 650; }

QPushButton, QToolButton {
    color: @color-text;
    background: @color-bg-card;
    border: 1px solid @color-border-input;
    border-radius: @radius-sm;
    padding: 9px 16px;
    font-weight: 500;
}
QPushButton:hover, QToolButton:hover { background: @color-bg-card-elev; }
QPushButton:pressed, QToolButton:pressed { background: @color-accent-trans-hover; }
QPushButton:disabled, QToolButton:disabled { color: @color-text-muted; border-color: @color-border; }
QPushButton:focus, QToolButton:focus, QComboBox:focus, QLineEdit:focus, QListView:focus {
    border: 2px solid @color-border-input-focus;
}

QPushButton#navButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: @radius-sm;
    padding: 0 12px;
    text-align: left;
    font-weight: 500;
    font-size: 10.75pt;
}
QPushButton#navButton:hover { background: @color-bg-card-elev; }
QPushButton#navButton:checked {
    color: @color-accent;
    background: @color-accent-trans;
    font-weight: 650;
}

QPushButton#primaryButton {
    color: @color-text-primary;
    background: @color-accent;
    border-color: @color-accent;
    font-weight: 600;
    padding: 10px 20px;
}
QPushButton#primaryButton:hover { background: @color-accent-hover; border-color: @color-accent-hover; }
QPushButton#primaryButton:focus { border: 2px solid @color-text-primary; }
QPushButton#secondaryButton, QToolButton#secondaryButton {
    color: @color-accent;
    background: @color-bg-card;
}
QPushButton#dangerButton { color: @color-error; border-color: @color-error; background: transparent; }
QPushButton#dangerButton:hover { background: rgba(180, 35, 47, 0.10); }

QMenu {
    color: @color-text;
    background: @color-bg-card;
    border: 1px solid @color-border;
    padding: 6px;
}
QMenu::item { padding: 8px 28px 8px 12px; border-radius: @radius-sm; }
QMenu::item:selected { background: @color-accent-trans-hover; }
QMenu::separator { height: 1px; background: @color-border; margin: 5px 4px; }

QLabel#pageTitle { font-size: 24pt; font-weight: 650; }
QLabel#pageSubtitle { color: @color-text-dim; font-size: 10.75pt; }
QLabel#sectionTitle { font-size: 12pt; font-weight: 650; }
QLabel#runHeading { font-size: 28pt; font-weight: 650; }
QLabel#runStatus { font-size: 14pt; font-weight: 550; }
QLabel#bodyText { color: @color-text-dim; font-size: 11pt; }
QLabel#hintText, QLabel#summaryCaption, QLabel#aboutVersion { color: @color-text-muted; }
QLabel#fileName { font-size: 12pt; font-weight: 550; }

QPushButton#dropZone {
    color: @color-text;
    background: @color-bg-card-elev;
    border: 1px dashed @color-accent;
    border-radius: @radius-lg;
    font-size: 12pt;
    font-weight: 600;
    padding: 12px 28px;
}
QPushButton#dropZone:hover, QPushButton#dropZone:focus {
    background: @color-accent-trans;
    border-color: @color-accent;
}

QFrame#filePanel, QFrame#summaryPanel {
    background: @color-bg-card;
    border: 1px solid @color-border;
    border-radius: @radius-lg;
}
QFrame#summaryPanel {
    background: transparent;
    border: none;
    border-radius: 0;
}
QFrame#summaryDivider { color: @color-border; background: @color-border; min-width: 1px; max-width: 1px; border: none; }

QLabel#phaseDot {
    color: @color-text-muted;
    background: @color-bg-card-elev;
    border: 1px solid @color-border-input;
    border-radius: 20px;
    font-weight: 600;
}
QLabel#phaseDot[state="active"] { color: @color-accent; border: 2px solid @color-accent; background: @color-accent-trans; }
QLabel#phaseDot[state="complete"] { color: @color-accent; border-color: @color-accent; }
QLabel#phaseLabel { color: @color-text-muted; font-size: 10pt; }
QLabel#phaseLabel[state="active"] { color: @color-accent; font-weight: 600; }
QLabel#phaseLabel[state="complete"] { color: @color-text-dim; }
QFrame#phaseLine { background: @color-border; min-height: 2px; max-height: 2px; }
QFrame#phaseLine[state="complete"] { background: @color-accent; }

QProgressBar#runProgress {
    background: @color-bg-card-elev;
    border: none;
    border-radius: 3px;
    min-height: 6px;
    max-height: 6px;
}
QProgressBar#runProgress::chunk { background: @color-accent; border-radius: 3px; }

QToolButton#disclosureButton {
    background: transparent;
    border: none;
    padding: 8px 2px;
}
QLabel#diagnosticPanel {
    color: @color-text-dim;
    background: @color-bg-card-elev;
    border: 1px solid @color-border;
    border-radius: @radius-md;
    padding: 12px;
    font-family: @type-mono;
    font-size: 9pt;
}
QLabel#summaryTotal { font-size: 40pt; font-weight: 450; }
QLabel#summarySuffix { color: @color-text-dim; font-size: 11pt; padding-bottom: 7px; }
QLabel#summaryValue { color: @color-text; font-weight: 550; }
QLabel#packageCount { font-weight: 650; }
QLabel#warningHeading { color: @color-text; font-weight: 650; border-top: 1px solid @color-border; padding-top: 10px; }
QLabel#warningText { color: @color-warning; }
QLabel#errorText { color: @color-error; background: @color-bg-card-elev; border-radius: @radius-md; padding: 14px; }
QLabel#summaryMeta { color: @color-text-dim; border-top: 1px solid @color-border; padding-top: 8px; }
QLabel#completeMark {
    color: @color-text-primary;
    background: @color-success;
    border-radius: 28px;
    font-size: 24pt;
    min-width: 56px; max-width: 56px; min-height: 56px; max-height: 56px;
}

QListView#runList {
    color: @color-text;
    background: @color-bg;
    border: none;
    outline: none;
}
QListView#runList::item {
    min-height: 72px;
    padding: 0;
    border-bottom: 1px solid @color-border;
}
QListView#runList::item:hover { background: @color-bg-card-elev; }
QListView#runList::item:selected { color: @color-text; background: @color-accent-trans; border-left: 2px solid @color-accent; }
QLabel#emptyState { color: @color-text-muted; font-size: 13pt; }

QWidget#settingsSection { background: transparent; }
QFrame#settingsDivider {
    color: @color-border;
    background: @color-border;
    border: none;
    min-height: 1px;
    max-height: 1px;
}
QLineEdit, QComboBox {
    color: @color-text;
    background: @color-bg-input;
    border: 1px solid @color-border-input;
    border-radius: @radius-sm;
    padding: 9px 11px;
    min-height: 22px;
    selection-background-color: @color-accent;
    selection-color: @color-text-primary;
}
QComboBox::drop-down { border: none; width: 26px; }
QComboBox QAbstractItemView { color: @color-text; background: @color-bg-card; border: 1px solid @color-border; selection-background-color: @color-accent-trans-hover; }
QLabel#sectionStatus { color: @color-text-muted; }
QLabel#sectionStatus[state="success"] { color: @color-success; }
QLabel#sectionStatus[state="error"] { color: @color-error; }

QFrame#aboutContent {
    background: transparent;
    border: none;
}

QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: @color-border-input; border-radius: 4px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QMessageBox { background: @color-bg; }
QToolTip { color: @color-text; background: @color-bg-card; border: 1px solid @color-border; padding: 5px; }
