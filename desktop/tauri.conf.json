{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tawreed",
  "version": "0.0.1",
  "identifier": "com.tawreed.desktop",
  "build": {
    "devUrl": "http://localhost:1430",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Tawreed",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://api.localhost api://localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
