{
  "name": "tawreed",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Portable desktop app that turns a construction BOQ workbook into a validated, procurement-ready work-package workbook.",
  "license": "MIT",
  "author": "Kareem Safwat",
  "homepage": "https://github.com/kareem-sf/tawreed",
  "repository": {
    "type": "git",
    "url": "https://github.com/kareem-sf/tawreed.git"
  },
  "bugs": {
    "url": "https://github.com/kareem-sf/tawreed/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/embed-legal.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --incremental false",
    "verify:assets": "node scripts/verify-vendor-assets.cjs",
    "verify:version": "node scripts/verify-version.cjs",
    "check": "npm run typecheck && npm test && npm run build && npm run verify:assets && npm run verify:version",
    "tauri": "tauri"
  },
  "dependencies": {
    "@mantine/core": "^7.17.0",
    "@mantine/hooks": "^7.17.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.5.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.0",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "pdf-lib": "^1.17.1",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
