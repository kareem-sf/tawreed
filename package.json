{
  "name": "tawreed",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Portable desktop app that turns a construction BOQ workbook into a validated, procurement-ready work-package workbook.",
  "license": "MIT",
  "author": "Kareem Safwat",
  "homepage": "https://github.com/kareem-sf/tawreed",
  "repository": {
    "type": "git",
    "url": "https://github.com/kareem-sf/tawreed.git"
  },
  "bugs": {
    "url": "https://github.com/kareem-sf/tawreed/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@12.0.2",
  "allowScripts": {
    "fsevents@2.3.3": true,
    "tesseract.js@7.0.0": true
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/embed-legal.cjs",
    "clean": "node -e \"for (const p of ['dist', 'node_modules/.vite', 'node_modules/.vite-temp']) require('node:fs').rmSync(p, { recursive: true, force: true })\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "eval": "node scripts/run-eval.mjs",
    "lint": "eslint \"{engine,shared,src,tests}/**/*.{ts,tsx}\" vite.config.ts playwright.config.ts eslint.config.js \"scripts/**/*.{cjs,mjs}\"",
    "typecheck": "tsc --noEmit --incremental false",
    "verify:assets": "node scripts/verify-vendor-assets.cjs",
    "verify:notices": "node scripts/verify-notices.cjs",
    "verify:install-scripts": "node scripts/verify-install-script-policy.cjs",
    "media:onboarding": "node scripts/generate-onboarding-media.mjs",
    "verify:version": "node scripts/verify-version.cjs",
    "sync:version": "node scripts/sync-release-version.cjs",
    "check": "npm run verify:install-scripts && npm run verify:architecture && npm run verify:commands && npm run verify:bindings && npm run verify:docs && npm run lint && npm run typecheck && npm test && npm run build && npm run verify:assets && npm run verify:notices && npm run verify:version",
    "tauri": "tauri",
    "verify:architecture": "node scripts/verify-architecture.cjs",
    "verify:commands": "node scripts/verify-commands.cjs",
    "verify:bindings": "node scripts/verify-bindings.cjs",
    "verify:docs": "node scripts/verify-docs.cjs"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "exceljs": "^4.4.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.47.0",
    "modelicons": "^0.1.3",
    "motion": "^13.4.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-window": "^2.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.5.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "edge-tts-universal": "^1.4.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "archiver": "8.0.0",
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "unzipper": "0.12.5",
    "uuid": "11.1.1"
  }
}
